{
  "name": "st-baibai-book",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "node localization/check.mjs && vite build --config vite.english.config.mjs",
    "test": "vitest run && node scripts/test-time-rel.mjs && node scripts/test-vector-depth.mjs && node scripts/test-memory-regressions.mjs",
    "test:english": "node localization/check.mjs && vitest run --config vite.english.config.mjs",
    "test:time": "node scripts/test-time-rel.mjs",
    "test:vector-depth": "node scripts/test-vector-depth.mjs",
    "test:memory": "node scripts/test-memory-regressions.mjs",
    "prewatch": "node scripts/sync-version.mjs",
    "watch": "vite build --watch --mode development --config vite.english.config.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.7.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "vue": "^3.5.35"
  }
}
